// TeamQueryColumns returns the columns to select for mask. Primary keys
// are always included, since relations are stitched on them.
func TeamQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 11+len(extra))
	cols = append(cols, "team_id")
	if m.Has("name") {
		cols = append(cols, "team_name")
	}
	if m.Has("motto") {
		cols = append(cols, "motto")
	}
	if m.Has("active") {
		cols = append(cols, "active")
	}
	if m.Has("founded") {
		cols = append(cols, "founded")
	}
	if m.Has("size") {
		cols = append(cols, "size")
	}
	if m.Has("score") {
		cols = append(cols, "score")
	}
	if m.Has("level") {
		cols = append(cols, "level")
	}
	if m.Has("meta") {
		cols = append(cols, "meta")
	}
	if m.Has("payload") {
		cols = append(cols, "payload")
	}
	if m.Has("parent") {
		cols = append(cols, "parent_id")
	}
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

// LoadTeamRows selects tbl_team rows matching conds and eagerly
// loads every relation the mask selects. extra forces columns into the SELECT
// regardless of the mask, which is how a parent gets the join key back.
func LoadTeamRows(ctx context.Context, c query.Conn, m *query.Mask, conds []query.Cond, extra ...string) ([]*TeamResult, error) {
	cols := TeamQueryColumns(m, extra...)
	sqlRows, err := c.Select(ctx, "tbl_team", cols, conds)
	if err != nil {
		return nil, err
	}
	defer sqlRows.Close()

	var rows []*TeamResult
	for sqlRows.Next() {
		row := new(TeamResult)
		if err := row.Scan(cols, sqlRows); err != nil {
			return nil, err
		}
		rows = append(rows, row)
	}
	if err := sqlRows.Err(); err != nil {
		return nil, err
	}
	if len(rows) == 0 {
		return rows, nil
	}

	if m.HasRelation("members") {
		byKey := make(map[any][]*TeamResult, len(rows))
		for _, row := range rows {
			key := query.Key(row.GetId())
			if key == nil {
				continue
			}
			byKey[key] = append(byKey[key], row)
		}
		if cond, ok := query.In("member_team", query.Keys(byKey)); ok {
			related, err := LoadMemberRows(ctx, c, m.Sub("members"), []query.Cond{cond}, "member_team")
			if err != nil {
				return nil, err
			}
			for _, rel := range related {
				for _, row := range byKey[query.Key(rel.fk_member_team_id)] {
					row.Members = append(row.Members, &rel.Member)
				}
			}
		}
	}

	if m.HasRelation("parent") {
		byKey := make(map[any][]*TeamResult, len(rows))
		for _, row := range rows {
			key := query.Key(row.fk_parent_id_id)
			if key == nil {
				continue
			}
			byKey[key] = append(byKey[key], row)
		}
		if cond, ok := query.In("team_id", query.Keys(byKey)); ok {
			related, err := LoadTeamRows(ctx, c, m.Sub("parent"), []query.Cond{cond})
			if err != nil {
				return nil, err
			}
			for _, rel := range related {
				for _, row := range byKey[query.Key(rel.GetId())] {
					row.Parent = &rel.Team
				}
			}
		}
	}

	return rows, nil
}

// LoadTeam selects tbl_team rows restricted to the fields mask
// names. A nil or empty mask selects every column and loads no relations.
func LoadTeam(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Team, error) {
	rows, err := LoadTeamRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
	}
	out := make([]*Team, len(rows))
	for i, row := range rows {
		out[i] = &row.Team
	}
	return out, nil
}

