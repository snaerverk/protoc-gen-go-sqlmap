	return map[string]filter.Field[*Team]{
		"id":      {Kind: filter.Int, Get: func(x *Team) []any { return []any{int64(x.GetId())} }},
		"name":    {Kind: filter.String, Get: func(x *Team) []any { return []any{x.GetName()} }},
		"active":  {Kind: filter.Bool, Get: func(x *Team) []any { return []any{x.GetActive()} }},
