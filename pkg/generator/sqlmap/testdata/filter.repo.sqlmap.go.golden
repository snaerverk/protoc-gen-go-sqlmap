type TeamResult struct {
	Team
	ts_founded      sql.NullTime
	fk_parent_id_id any
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *TeamResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "team_id":
			values[i] = &n.Id
		case "team_name":
			values[i] = &n.Name
		case "motto":
			values[i] = &n.Motto
		case "active":
			values[i] = &n.Active
		case "founded":
			values[i] = &n.ts_founded
		case "size":
			values[i] = &n.Size
		case "score":
			values[i] = &n.Score
		case "level":
			values[i] = &n.Level
		case "meta":
			values[i] = &n.Meta
		case "payload":
			values[i] = &n.Payload
		case "parent_id":
			values[i] = &n.fk_parent_id_id
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	if err := r.Scan(values...); err != nil {
		return err
	}
	// Left nil when the column is NULL, so an absent timestamp stays absent
	// rather than becoming the zero instant.
	if n.ts_founded.Valid {
		n.Founded = timestamppb.New(n.ts_founded.Time)
	}
	return nil
}

func (n *Team) GetColValue(col string) any {
	switch col {
	case "team_id":
		return n.Id
	case "team_name":
		return n.Name
	case "motto":
		return n.Motto
	case "active":
		return n.Active
	case "founded":
		// Handed back as a time.Time, which is what a driver can bind.
		if n.Founded == nil {
			return nil
		}
		return n.Founded.AsTime()
	case "size":
		return n.Size
	case "score":
		return n.Score
	case "level":
		return n.Level
	case "meta":
		return n.Meta
	case "payload":
		return n.Payload
	case "parent_id":
		return n.Parent
	default:
		return nil
	}
}

