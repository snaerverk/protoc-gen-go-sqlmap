// TeamFilter declares what filtrify filters and page orders over
// tbl_team may name: proto field names, mapped to qualified columns.
// Not filterable:
//   - score: filtrify has no float kind yet
//   - level: enums are not supported yet
//   - meta: JSON column
//   - payload: embedded message (JSON)
//   - has(parent, ...): self-referencing relations need table aliases, not supported yet
var TeamFilter = &sql1.Schema{
	Columns: map[string]sql1.Column{
		"id":      {SQL: "tbl_team.team_id", Kind: filter.Int},
		"name":    {SQL: "tbl_team.team_name", Kind: filter.String},
		"motto":   {SQL: "tbl_team.motto", Kind: filter.String},
		"active":  {SQL: "tbl_team.active", Kind: filter.Bool},
		"founded": {SQL: "tbl_team.founded", Kind: filter.Time},
		"size":    {SQL: "tbl_team.size", Kind: filter.Int},
		"parent":  {SQL: "tbl_team.parent_id", Kind: filter.Int},
	},
	Sortable: []string{"id", "name", "active", "founded"},
	Key:      sql1.Column{SQL: "tbl_team.team_id", Kind: filter.Int},
}

// Relations refer to other tables' schemas, so they are set once all exist.
func init() {
	TeamFilter.Relations = map[string]sql1.Relation{
		"members": {From: "tbl_member", Join: "tbl_member.member_team = tbl_team.team_id", Schema: MemberFilter},
	}
}

