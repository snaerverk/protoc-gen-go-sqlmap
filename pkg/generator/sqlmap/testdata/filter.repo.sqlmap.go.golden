func (TeamRepo) Columns(m *query.Mask) []string { return TeamQueryColumns(m) }

func (TeamRepo) ScanRow(cols []string, s query.Scanner) (*Team, error) {
	res := new(TeamResult)
	if err := res.Scan(cols, s); err != nil {
		return nil, err
	}
